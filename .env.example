# ---------- LLM ----------
# DeepSeek 官方：https://api.deepseek.com
# 若使用中转/代理网关，把 DEEPSEEK_BASE_URL 改成对应地址
# 不填 DEEPSEEK_BASE_URL 时，langchain_deepseek 默认走 https://api.deepseek.com
# 若使用中转网关/自建代理，填对应地址（例如网关提供的 /v1 入口）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=
# 官方模型名：deepseek-chat / deepseek-reasoner
# 开发环境原值为 deepseek-v4-flash（需网关支持该模型名）
CHAT_MODEL_NAME=deepseek-chat
LLM_TEMPERATURE=0.1

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=mysql_database
MYSQL_CONNECT_TIMEOUT=5

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------- RAG / 本地模型 ----------
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL_NAME=qwen3-embedding:4b
RERANKER_PATH=./models/bge-reranker-v2-m3
# cpu / cuda（有 NVIDIA 显卡且装了 CUDA 版 torch 时可改为 cuda）
RERANKER_DEVICE=cpu
RERANKER_ENABLED=true

# ---------- 运行参数 ----------
# 是否启用 MCP 文件工具子进程（无 fastmcp/langchain-mcp 环境时可设为 0）
MCP_ENABLED=true
# Agent / MCP 可写工作区
AGENT_WORKSPACE_DIR=./Agent/mcp_tools/workspace
LOG_DIR=./logs
LOG_LEVEL=INFO

# ---------- 服务端口 ----------
API_HOST=0.0.0.0
API_PORT=8000
# 前端访问后端的地址（在容器内应为 http://api:8000）
BACKEND_BASE_URL=http://127.0.0.1:8000
# CORS 允许来源，多个用逗号分隔
CORS_ORIGINS=http://127.0.0.1:8501,http://localhost:8501

# ---------- 可选：向量库位置 ----------
# 兼容原有索引目录时设为 RAG/data/chroma_db；默认落在 <repo>/data/chroma_db
# CHROMA_PERSIST_DIR=data/chroma_db
# CHROMA_MD5_PATH=data/md5.txt
